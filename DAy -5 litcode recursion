Factorial Of a Number
#include <iostream>

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int main() {
    int number = 5;
    
    int result = factorial(number);
    
    std::cout << result << "\n";
    
    return 0;
}

Fibonacci Series 
#include <iostream>

int fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

int main() {
    int n = 10;
    
    for (int i = 0; i < n; ++i) {
        std::cout << fibonacci(i) << " ";
    }
    
    std::cout << "\n";
    
    return 0;
}

